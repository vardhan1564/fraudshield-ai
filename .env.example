# Copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_PER_MINUTE=10
PARTNER_API_KEYS=                # name:key,name2:key2 (X-API-Key for partner systems)

# --- PostgreSQL ---
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each new
# connection waits ~2 s, because docker compose publishes ports on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fraudshield
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield
DATABASE_URL=postgresql+asyncpg://fraudshield:fraudshield@127.0.0.1:5432/fraudshield

# --- Redis (cache, live features, event streams) ---
REDIS_URL=redis://127.0.0.1:6379/0
STREAM_SCORED=stream:transactions.scored
STREAM_CASES=stream:cases.labeled
STREAM_REPORTS=stream:reports.created

# --- Graph ---
GRAPH_BACKEND=networkx          # networkx (default) | neo4j (optional)
GRAPH_REFRESH_MINUTES=5
NEO4J_URI=bolt://localhost:7687 # only if GRAPH_BACKEND=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- ML ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MODEL_DIR=ml/artifacts

# --- LLM (explanations, Scam Coach text, message scanner advice) ---
LLM_PROVIDER=anthropic          # anthropic | ollama | template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_MS=1500

# --- Frontend (Vite) ---
# Relative: the Vite dev server proxies /api to the backend, so a phone on the same Wi-Fi works
VITE_API_URL=/api/v1
VITE_WS_URL=/api/v1/ws
